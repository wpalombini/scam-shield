# Copy to .env, which git ignores. Set a low spending limit on this key.
OPENROUTER_API_KEY=
# Your user and group IDs from `id -u` and `id -g`, so scored runs can save reports.
HOST_UID=1000
HOST_GID=1000
# Optional: override the default model.
# SCAM_SHIELD_MODEL=anthropic/claude-haiku-5.5
# Knowledge base. Choose your own password, and use the same one in both lines.
# POSTGRES_PASSWORD=
# SCAM_SHIELD_DATABASE_URL=postgresql://scamshield:<password>@db:5432/scamshield
# Optional: use known scam patterns on the checker page and command line.
# SCAM_SHIELD_KNOWLEDGE=on
# Optional: the local port for the checker page.
# SCAM_SHIELD_WEB_PORT=8080
